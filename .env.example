# Site Configuration
NEXT_PUBLIC_SITE_URL=https://your-blog-domain.com

# Supabase Configurations
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Postgres Database URL (e.g. Supabase Connection Pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Admin panel password for /admin dashboard authentication
ADMIN_PASSWORD=your-secure-admin-password
